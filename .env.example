# Database Configuration (matches docker-compose.yml defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/payment_db
DATABASE_NAME=payment_db
DATABASE_USERNAME=payment_user
DATABASE_PASSWORD=payment_secret
DATABASE_PORT=5432

# Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local
PAYMENT_GATEWAY=fake

# Security (Dev API key & Fake Webhook Secret)
APP_API_KEY=dev-api-key-12345
FAKE_GATEWAY_WEBHOOK_SECRET=fake-webhook-secret-key-12345
